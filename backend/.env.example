# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Neon console → your project → Connect → copy the connection string (keep ?sslmode=require).
# The pooled ("-pooler") string works too.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Create/update tables automatically on start. Fine for development; set false in production.
DB_SYNC=true
# Insert the demo data (users, resellers, chats…) when the database is empty.
SEED_DEMO=true
# Allow POST /api/v1/dev/reset (admin only) to wipe and re-seed the demo data.
ALLOW_RESET=true

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
# Browser origins allowed to call the API (comma-separated). * = any (e.g. testing from a phone).
CORS_ORIGINS=http://localhost:3000

# ─── Security — use long random strings in production ────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Session cookie for the web app — set true when served over HTTPS.
COOKIE_SECURE=false
# Channel provider sends this in the x-webhook-secret header.
WEBHOOK_SECRET=dev-webhook-secret

# ─── Uploads ─────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=10

# ─── Abuse protection (defaults shown; all optional) ─────────────────────────
# Requests per minute: per IP address / per signed-in user / actions per user (team gets 5x).
# RATE_IP_PER_MIN=300
# RATE_USER_PER_MIN=240
# RATE_ACTIONS_PER_MIN=60
# Multiplies the per-IP / per-user limits above (e.g. 100 for the e2e tests or load tests).
# RATE_LIMIT_SCALE=1
# Wrong passwords in a row before an account is locked, and for how long.
# LOGIN_MAX_WRONG=5
# LOGIN_LOCK_MIN=15
# New accounts per IP per hour / per day, and in total per hour.
# SIGNUP_PER_IP_HOUR=3
# SIGNUP_PER_IP_DAY=10
# SIGNUP_PER_HOUR=200
# Uploads per user in 24 hours. New accounts (first NEW_ACCOUNT_HOURS) / everyone else / team.
# NEW_ACCOUNT_HOURS=24
# UPLOAD_NEW_FILES_DAY=30
# UPLOAD_NEW_MB_DAY=50
# UPLOAD_FILES_DAY=300
# UPLOAD_MB_DAY=1024
# UPLOAD_TEAM_FILES_DAY=2000
# UPLOAD_TEAM_MB_DAY=5120
# Uploads running at the same time, per user.
# UPLOAD_PARALLEL=3

# ─── Email (sign-up codes) ───────────────────────────────────────────────────
# New customers confirm their email with a 6-digit code before they can sign in. Off for now.
# EMAIL_VERIFICATION=false
# Any SMTP service works. Without SMTP_HOST nothing is emailed: the code is printed in backend/logs/backend.log
# and (outside production) returned to the app as `devCode`, so you can test without a mail account.
#   Resend:  SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=<API key>
#   Brevo:   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<login>  SMTP_PASS=<SMTP key>
#   Gmail:   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=<you@gmail.com>  SMTP_PASS=<app password>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Your Company <no-reply@yourdomain.com>
# Show the code to the app while testing (default: on outside production when SMTP_HOST is empty).
# EMAIL_DEV_CODES=false
