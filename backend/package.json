{
  "name": "business-messaging-api",
  "version": "2.0.0",
  "private": true,
  "description": "Business Messaging API \u2014 NestJS + TypeScript + PostgreSQL (Neon) + Socket.IO",
  "scripts": {
    "build": "nest build",
    "prestart": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "seed": "node dist/database/seed/run-seed",
    "test:e2e": "node --test --test-concurrency=1 \"test/*.e2e.mjs\""
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.6",
    "bcryptjs": "^3.0.2",
    "dotenv": "^18.0.10",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.6.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.9.2"
  }
}
